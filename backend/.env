# Project Settings
PROJECT_NAME="Multi-Camera Intelligence Backend"

# Database Configuration
# When running via docker-compose, use 'postgres' as the host. For local testing without docker, use 'localhost'.
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/video_intelligence"

# Redis Configuration (for Celery and caching)
REDIS_URL="redis://localhost:6379/0"

# Qdrant Vector Database
QDRANT_URL="http://localhost:6333"

# Storage
STORAGE_PATH="./storage"

# External Models (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_REASONING_MODEL="qwen3.5:4B"
OLLAMA_VISION_MODEL="qwen3.5:4B"
OLLAMA_TIMEOUT=30.0

# Optional API Keys for External Services (if you choose to add external cloud models later)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

OLLAMA_AUTH_USER="ollama"
OLLAMA_AUTH_PASSWORD="123456789"
